        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Проверка" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script">
import groovy.json.JsonSlurper
import groovy.json.JsonOutput

BASE = &apos;http://&apos; + props.getProperty(&apos;host&apos;, &apos;localhost&apos;) + &apos;:&apos; + props.getProperty(&apos;port&apos;, &apos;8080&apos;) + props.getProperty(&apos;ctx&apos;, &apos;&apos;) + &apos;/api&apos;
PASS = props.getProperty(&apos;pass&apos;, &apos;jmeter-pass&apos;)
RUN = props.getProperty(&apos;run&apos;, &apos;&apos;)
N = Integer.parseInt(props.getProperty(&apos;users&apos;, &apos;8&apos;))


def api(String method, String path, Object body, int userNo) {
    def conn = (HttpURLConnection) new URL(BASE + path).openConnection()
    conn.setRequestMethod(method)
    conn.setConnectTimeout(5000)
    conn.setReadTimeout(90000)
    def auth = (&apos;jmu&apos; + userNo + &apos;:&apos; + PASS).getBytes(&apos;UTF-8&apos;).encodeBase64().toString()
    conn.setRequestProperty(&apos;Authorization&apos;, &apos;Basic &apos; + auth)
    conn.setRequestProperty(&apos;Content-Type&apos;, &apos;application/json; charset=UTF-8&apos;)
    if (body != null) {
        conn.setDoOutput(true)
        def payload = (body instanceof String) ? body : JsonOutput.toJson(body)
        conn.getOutputStream().write(payload.getBytes(&apos;UTF-8&apos;))
    }
    int code = conn.getResponseCode()
    def stream = code &gt;= 400 ? conn.getErrorStream() : conn.getInputStream()
    def text = stream == null ? &apos;&apos; : stream.getText(&apos;UTF-8&apos;)
    def json = null
    try { if (text) { json = new JsonSlurper().parseText(text) } } catch (Exception ignored) { }
    return [code: code, text: text, json: json]
}


def counts(String g) {
    def m = [:]
    def prefix = &apos;res.&apos; + g + &apos;.&apos;
    props.stringPropertyNames().each { String k -&gt;
        if (k.startsWith(prefix)) { m[k.substring(prefix.length())] = Integer.parseInt(props.getProperty(k)) }
    }
    return m
}
def cnt(Map m, String code) { return m.containsKey(code) ? m[code] : 0 }
def total(Map m) { int t = 0; m.each { k, v -&gt; t += v }; return t }
def only(Map m, List allowed) { return m.keySet().findAll { !allowed.contains(it) } }

def problems = []
def details = []
for (def spec : [[&apos;updorg&apos;, &apos;organizations&apos;, &apos;fx.upd.org&apos;, &apos;fx.upd.org.ver0&apos;], [&apos;updcoord&apos;, &apos;coordinates&apos;, &apos;fx.upd.cc&apos;, &apos;fx.upd.cc.ver0&apos;]]) {
    if (!props.getProperty(spec[2]) || !props.getProperty(spec[3])) {
        problems &lt;&lt; (spec[1] + &apos;: подготовка 2a не выполнена (смотрите результат «Подготовка» и ответы группы 2)&apos;)
        continue
    }
    def m = counts(spec[0])
    details &lt;&lt; (spec[1] + &apos;: ответы &apos; + m)
    if (cnt(m, &apos;200&apos;) != 1) { problems &lt;&lt; (spec[1] + &apos;: успешных изменений &apos; + cnt(m, &apos;200&apos;) + &apos;, ожидался ровно один (иначе потерянное обновление)&apos;) }
    if (cnt(m, &apos;409&apos;) != N - 1) { problems &lt;&lt; (spec[1] + &apos;: конфликтов &apos; + cnt(m, &apos;409&apos;) + &apos;, ожидалось &apos; + (N - 1)) }
    if (!only(m, [&apos;200&apos;, &apos;409&apos;]).isEmpty()) { problems &lt;&lt; (spec[1] + &apos;: неожиданные коды &apos; + only(m, [&apos;200&apos;, &apos;409&apos;])) }
    def f = api(&apos;GET&apos;, &apos;/&apos; + spec[1] + &apos;/&apos; + props.getProperty(spec[2]), null, 1)
    long expectedVer = Long.parseLong(props.getProperty(spec[3])) + 1
    if (f.code != 200 || f.json.version != expectedVer) { problems &lt;&lt; (spec[1] + &apos;: версия после гонки &apos; + f.json?.version + &apos;, ожидалась &apos; + expectedVer) }
}

SampleResult.setResponseData((problems.isEmpty() ? &apos;OK\n&apos; : &apos;НАРУШЕНИЕ\n&apos;) + details.join(&apos;\n&apos;) + (problems.isEmpty() ? &apos;&apos; : &apos;\n--- проблемы ---\n&apos; + problems.join(&apos;\n&apos;)), &apos;UTF-8&apos;)
SampleResult.setSuccessful(problems.isEmpty())
SampleResult.setResponseCode(problems.isEmpty() ? &apos;200&apos; : &apos;500&apos;)
SampleResult.setResponseMessage(problems.isEmpty() ? &apos;OK&apos; : &apos;Нарушение инварианта&apos;)
</stringProp>
        </JSR223Sampler>
        <hashTree/>
      </hashTree>
