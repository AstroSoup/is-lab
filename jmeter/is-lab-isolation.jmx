      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="8. История импорта: каждый пользователь видит только свои операции" enabled="true">
        <stringProp name="ThreadGroup.num_threads">${__P(users,8)}</stringProp>
        <intProp name="ThreadGroup.ramp_time">0</intProp>
