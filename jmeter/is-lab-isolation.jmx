            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">def run = props.getProperty(&apos;run&apos;, &apos;&apos;)
def t = String.valueOf(ctx.getThreadNum() + 1)
def rows = [&apos;name,fullName,coordinatesX,coordinatesY,annualTurnover,employeesCount,rating,type,officialAddress,postalAddress&apos;]
