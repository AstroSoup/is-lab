def expected = [&apos;200&apos;]
def code = prev.getResponseCode()
prev.setSuccessful(expected.contains(code))
if (!expected.contains(code)) {
    prev.setResponseMessage(&apos;ожидался &apos; + expected + &apos;, получен &apos; + code + &apos;: &apos; + prev.getResponseDataAsString())
}

if (prev.isSuccessful()) {
    def j = new groovy.json.JsonSlurper().parseText(prev.getResponseDataAsString())
    if (j.rating != 5 || j.version != Long.parseLong(vars.get(&apos;orgVer&apos;)) + 1) {
        prev.setSuccessful(false)
        prev.setResponseMessage(&apos;изменение не применилось или версия не увеличилась: &apos; + prev.getResponseDataAsString())
    }
}
