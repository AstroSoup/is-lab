        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Loop Controller">
          <stringProp name="LoopController.loops">1</stringProp>
          <boolProp name="LoopController.continue_forever">false</boolProp>
        </elementProp>
      </ThreadGroup>
      <hashTree>
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="8.1 История операций" enabled="true">
          <stringProp name="HTTPSampler.path">${__P(ctx,)}/api/import/history</stringProp>
          <stringProp name="HTTPSampler.method">GET</stringProp>
          <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
          <boolProp name="HTTPSampler.postBodyRaw">false</boolProp>
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="User Defined Variables">
            <collectionProp name="Arguments.arguments"/>
          </elementProp>
        </HTTPSamplerProxy>
        <hashTree>
          <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Проверка видимости" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">
def admins = (props.getProperty(&apos;admins&apos;, &apos;&apos;)).split(&apos;,&apos;).collect { it.trim() }.findAll { it }
def own = &apos;jmu&apos; + (ctx.getThreadNum() + 1)
if (prev.getResponseCode() != &apos;200&apos; || !prev.getResponseDataAsString()) {
    prev.setSuccessful(false)
    prev.setResponseMessage(&apos;история: код &apos; + prev.getResponseCode() + &apos;, тело пустое&apos;)
    return
}
def items = new groovy.json.JsonSlurper().parseText(prev.getResponseDataAsString())
def bad = 0
items.each {
    if (!admins.contains(own) &amp;&amp; it.user != own) { bad++ }
    if (it.status == &apos;SUCCESS&apos; &amp;&amp; it.added == null) { bad++ }
    if (it.status == &apos;FAILED&apos; &amp;&amp; it.added != null) { bad++ }
}
synchronized (props) {
    props.setProperty(&apos;hist.bad&apos;, String.valueOf(Integer.parseInt(props.getProperty(&apos;hist.bad&apos;, &apos;0&apos;)) + bad))
    props.setProperty(&apos;hist.seen&apos;, String.valueOf(Integer.parseInt(props.getProperty(&apos;hist.seen&apos;, &apos;0&apos;)) + items.size()))
}
</stringProp>
          </JSR223PostProcessor>
          <hashTree/>
        </hashTree>
      </hashTree>
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="8c. Проверка истории" enabled="true">
        <intProp name="ThreadGroup.num_threads">1</intProp>
        <intProp name="ThreadGroup.ramp_time">0</intProp>
        <boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp>
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Loop Controller">
          <stringProp name="LoopController.loops">1</stringProp>
          <boolProp name="LoopController.continue_forever">false</boolProp>
        </elementProp>
      </ThreadGroup>
      <hashTree>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Проверка" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script">
import groovy.json.JsonSlurper
import groovy.json.JsonOutput

BASE = &apos;http://&apos; + props.getProperty(&apos;host&apos;, &apos;localhost&apos;) + &apos;:&apos; + props.getProperty(&apos;port&apos;, &apos;8080&apos;) + props.getProperty(&apos;ctx&apos;, &apos;&apos;) + &apos;/api&apos;
PASS = props.getProperty(&apos;pass&apos;, &apos;jmeter-pass&apos;)
RUN = props.getProperty(&apos;run&apos;, &apos;&apos;)
N = Integer.parseInt(props.getProperty(&apos;users&apos;, &apos;8&apos;))


def api(String method, String path, Object body, int userNo) {
    def conn = (HttpURLConnection) new URL(BASE + path).openConnection()
    conn.setRequestMethod(method)
    conn.setConnectTimeout(5000)
    conn.setReadTimeout(90000)
    def auth = (&apos;jmu&apos; + userNo + &apos;:&apos; + PASS).getBytes(&apos;UTF-8&apos;).encodeBase64().toString()
    conn.setRequestProperty(&apos;Authorization&apos;, &apos;Basic &apos; + auth)
    conn.setRequestProperty(&apos;Content-Type&apos;, &apos;application/json; charset=UTF-8&apos;)
    if (body != null) {
        conn.setDoOutput(true)
        def payload = (body instanceof String) ? body : JsonOutput.toJson(body)
        conn.getOutputStream().write(payload.getBytes(&apos;UTF-8&apos;))
    }
    int code = conn.getResponseCode()
    def stream = code &gt;= 400 ? conn.getErrorStream() : conn.getInputStream()
    def text = stream == null ? &apos;&apos; : stream.getText(&apos;UTF-8&apos;)
    def json = null
    try { if (text) { json = new JsonSlurper().parseText(text) } } catch (Exception ignored) { }
    return [code: code, text: text, json: json]
}


def counts(String g) {
    def m = [:]
    def prefix = &apos;res.&apos; + g + &apos;.&apos;
    props.stringPropertyNames().each { String k -&gt;
        if (k.startsWith(prefix)) { m[k.substring(prefix.length())] = Integer.parseInt(props.getProperty(k)) }
    }
    return m
}
def cnt(Map m, String code) { return m.containsKey(code) ? m[code] : 0 }
def total(Map m) { int t = 0; m.each { k, v -&gt; t += v }; return t }
def only(Map m, List allowed) { return m.keySet().findAll { !allowed.contains(it) } }

def problems = []
def bad = Integer.parseInt(props.getProperty(&apos;hist.bad&apos;, &apos;0&apos;))
def seen = Integer.parseInt(props.getProperty(&apos;hist.seen&apos;, &apos;0&apos;))
def details = [&apos;просмотрено записей истории: &apos; + seen, &apos;нарушений видимости/полей: &apos; + bad]
if (seen == 0) { problems &lt;&lt; &apos;история пуста, хотя импорты выполнялись&apos; }
if (bad &gt; 0) { problems &lt;&lt; (&apos;нарушений: &apos; + bad + &apos; (чужие операции у обычного пользователя, added у неуспешной или null у успешной операции)&apos;) }

SampleResult.setResponseData((problems.isEmpty() ? &apos;OK\n&apos; : &apos;НАРУШЕНИЕ\n&apos;) + details.join(&apos;\n&apos;) + (problems.isEmpty() ? &apos;&apos; : &apos;\n--- проблемы ---\n&apos; + problems.join(&apos;\n&apos;)), &apos;UTF-8&apos;)
SampleResult.setSuccessful(problems.isEmpty())
SampleResult.setResponseCode(problems.isEmpty() ? &apos;200&apos; : &apos;500&apos;)
SampleResult.setResponseMessage(problems.isEmpty() ? &apos;OK&apos; : &apos;Нарушение инварианта&apos;)
</stringProp>
        </JSR223Sampler>
        <hashTree/>
      </hashTree>
