      <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Вычисление заголовка Authorization" enabled="true">
        <stringProp name="scriptLanguage">groovy</stringProp>
        <stringProp name="parameters"></stringProp>
        <stringProp name="filename"></stringProp>
        <stringProp name="cacheKey">true</stringProp>
        <stringProp name="script">def login = &apos;jmu&apos; + (ctx.getThreadNum() + 1)
def pass = props.getProperty(&apos;pass&apos;, &apos;jmeter-pass&apos;)
vars.put(&apos;auth&apos;, &apos;Basic &apos; + (login + &apos;:&apos; + pass).getBytes(&apos;UTF-8&apos;).encodeBase64().toString())
</stringProp>
      </JSR223PreProcessor>
      <hashTree/>
      <SetupThreadGroup guiclass="SetupThreadGroupGui" testclass="SetupThreadGroup" testname="setUp. Идентификатор прогона и регистрация пользователей" enabled="true">
        <intProp name="ThreadGroup.num_threads">1</intProp>
        <intProp name="ThreadGroup.ramp_time">0</intProp>
        <boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp>
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Loop Controller">
          <stringProp name="LoopController.loops">1</stringProp>
          <boolProp name="LoopController.continue_forever">false</boolProp>
        </elementProp>
      </SetupThreadGroup>
      <hashTree>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Инициализация" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script">
import groovy.json.JsonSlurper
import groovy.json.JsonOutput

BASE = &apos;http://&apos; + props.getProperty(&apos;host&apos;, &apos;localhost&apos;) + &apos;:&apos; + props.getProperty(&apos;port&apos;, &apos;8080&apos;) + props.getProperty(&apos;ctx&apos;, &apos;&apos;) + &apos;/api&apos;
PASS = props.getProperty(&apos;pass&apos;, &apos;jmeter-pass&apos;)
RUN = props.getProperty(&apos;run&apos;, &apos;&apos;)
N = Integer.parseInt(props.getProperty(&apos;users&apos;, &apos;8&apos;))

def api(String method, String path, Object body, int userNo) {
    def conn = (HttpURLConnection) new URL(BASE + path).openConnection()
    conn.setRequestMethod(method)
    conn.setConnectTimeout(5000)
    conn.setReadTimeout(90000)
    def auth = (&apos;jmu&apos; + userNo + &apos;:&apos; + PASS).getBytes(&apos;UTF-8&apos;).encodeBase64().toString()
    conn.setRequestProperty(&apos;Authorization&apos;, &apos;Basic &apos; + auth)
    conn.setRequestProperty(&apos;Content-Type&apos;, &apos;application/json; charset=UTF-8&apos;)
    if (body != null) {
        conn.setDoOutput(true)
        def payload = (body instanceof String) ? body : JsonOutput.toJson(body)
        conn.getOutputStream().write(payload.getBytes(&apos;UTF-8&apos;))
    }
    int code = conn.getResponseCode()
    def stream = code &gt;= 400 ? conn.getErrorStream() : conn.getInputStream()
    def text = stream == null ? &apos;&apos; : stream.getText(&apos;UTF-8&apos;)
    def json = null
    try { if (text) { json = new JsonSlurper().parseText(text) } } catch (Exception ignored) { }
    return [code: code, text: text, json: json]
}

def counts(String g) {
    def m = [:]
    def prefix = &apos;res.&apos; + g + &apos;.&apos;
    props.stringPropertyNames().each { String k -&gt;
        if (k.startsWith(prefix)) { m[k.substring(prefix.length())] = Integer.parseInt(props.getProperty(k)) }
    }
    return m
}
def cnt(Map m, String code) { return m.containsKey(code) ? m[code] : 0 }
def total(Map m) { int t = 0; m.each { k, v -&gt; t += v }; return t }
def only(Map m, List allowed) { return m.keySet().findAll { !allowed.contains(it) } }

if (!props.getProperty(&apos;run&apos;)) {
    props.setProperty(&apos;run&apos;, String.valueOf(System.currentTimeMillis() % 100000000L))
}
RUN = props.getProperty(&apos;run&apos;)
props.setProperty(&apos;dedupe_y&apos;, String.valueOf(100 + (Long.parseLong(RUN) % 700L)))
def problems = []
def details = [&apos;идентификатор прогона: &apos; + RUN, &apos;потоков (пользователей): &apos; + N]
for (int i = 1; i &lt;= N; i++) {
    def conn = (HttpURLConnection) new URL(BASE + &apos;/register&apos;).openConnection()
    conn.setRequestMethod(&apos;POST&apos;)
    conn.setDoOutput(true)
    conn.setRequestProperty(&apos;Content-Type&apos;, &apos;application/json; charset=UTF-8&apos;)
    conn.getOutputStream().write(JsonOutput.toJson([name: &apos;jmu&apos; + i, password: PASS]).getBytes(&apos;UTF-8&apos;))
    int code = conn.getResponseCode()
    def text = (code &gt;= 400 ? conn.getErrorStream() : conn.getInputStream())?.getText(&apos;UTF-8&apos;) ?: &apos;&apos;
    if (code == 404) {
        problems &lt;&lt; (&apos;POST &apos; + BASE + &apos;/register вернул 404. Либо сервер запущен без -Dislab.api.enabled=true, либо приложение развёрнуто не в корне&apos;)
        break
    }
    if (code != 201 &amp;&amp; !(code == 400 &amp;&amp; text.contains(&apos;уже существует&apos;))) {
        problems &lt;&lt; (&apos;регистрация jmu&apos; + i + &apos; не удалась: &apos; + code + &apos; &apos; + text)
    }
}
if (problems.isEmpty()) {
    def probe = api(&apos;GET&apos;, &apos;/import/history&apos;, null, 1)
    details &lt;&lt; (&apos;проверка входа jmu1: GET /import/history -&gt; &apos; + probe.code)
    if (probe.code != 200) { problems &lt;&lt; (&apos;вход под jmu1 не удался: &apos; + probe.code + &apos; &apos; + probe.text) }
}
if (!problems.isEmpty()) {
    problems.each { log.error(&apos;IS-Lab setUp: &apos; + it) }
    ctx.getEngine().askThreadsToStop()  
}

SampleResult.setResponseData((problems.isEmpty() ? &apos;OK\n&apos; : &apos;НАРУШЕНИЕ\n&apos;) + details.join(&apos;\n&apos;) + (problems.isEmpty() ? &apos;&apos; : &apos;\nпроблемы\n&apos; + problems.join(&apos;\n&apos;)), &apos;UTF-8&apos;)
SampleResult.setSuccessful(problems.isEmpty())
SampleResult.setResponseCode(problems.isEmpty() ? &apos;200&apos; : &apos;500&apos;)
SampleResult.setResponseMessage(problems.isEmpty() ? &apos;OK&apos; : &apos;Нарушение инварианта&apos;)
</stringProp>
        </JSR223Sampler>
        <hashTree/>
