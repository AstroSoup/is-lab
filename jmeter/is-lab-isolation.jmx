def expected = [&apos;201&apos;]
def code = prev.getResponseCode()
prev.setSuccessful(expected.contains(code))
if (!expected.contains(code)) {
    prev.setResponseMessage(&apos;ожидался &apos; + expected + &apos;, получен &apos; + code + &apos;: &apos; + prev.getResponseDataAsString())
}
</stringProp>
