def group = &apos;updorg&apos;
def expected = [&apos;200&apos;, &apos;409&apos;]
def code = prev.getResponseCode()
synchronized (props) {
    def k = &apos;res.&apos; + group + &apos;.&apos; + code
    props.setProperty(k, String.valueOf(Integer.parseInt(props.getProperty(k, &apos;0&apos;)) + 1))
}
prev.setSuccessful(expected.contains(code))
if (!expected.contains(code)) {
    prev.setResponseMessage(&apos;неожиданный статус &apos; + code + &apos;: &apos; + prev.getResponseDataAsString())
}
